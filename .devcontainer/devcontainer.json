{
  "name": "tunnel-orchestrator",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers-contrib/features/terraform-asdf:2": {},
    "ghcr.io/devcontainers-contrib/features/uv:1": {}
  },
  "forwardPorts": [8000, 9092, 5432, 6379, 8081, 8080, 3301, 4317, 4318],
  "portsAttributes": {
    "8000": { "label": "FastAPI" },
    "9092": { "label": "Kafka" },
    "5432": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" },
    "8081": { "label": "Schema Registry" },
    "8080": { "label": "Kafka UI" },
    "3301": { "label": "SigNoz UI" },
    "4317": { "label": "OTLP gRPC" }
  },
  "postCreateCommand": "make install && make env",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "hashicorp.terraform",
        "redhat.vscode-xml",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  }
}
