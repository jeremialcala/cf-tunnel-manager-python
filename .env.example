# =====================================================================
# Tunnel Orchestrator — environment template
# =====================================================================
# Copy to .env and fill in. NEVER commit secrets.
# In production, all secret values come from Vault / SealedSecrets / CSI.
# =====================================================================

# ---------- App ----------
APP_NAME=tunnel-orchestrator
APP_ENV=local                 # local | dev | staging | prod
APP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
APP_LOG_FORMAT=json           # json | console
APP_DEBUG=false

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_DOCS_ENABLED=true

# ---------- Auth (JWT) ----------
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=/etc/keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/etc/keys/jwt_private.pem
JWT_ISSUER=https://auth.higuerotech.com
JWT_AUDIENCE=tunnel-orchestrator
JWT_LEEWAY_SECONDS=30

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql+asyncpg://tunnel:tunnel@localhost:5432/tunnel_orchestrator
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=120
REDIS_CACHE_TTL_SECONDS=300

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=tunnel-orchestrator
KAFKA_CONSUMER_GROUP=tunnel-orchestrator-workers
KAFKA_SECURITY_PROTOCOL=PLAINTEXT          # PLAINTEXT | SASL_SSL | SSL
KAFKA_SASL_MECHANISM=                      # PLAIN | SCRAM-SHA-512 | OAUTHBEARER
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TRANSACTIONAL_ID_PREFIX=tunnel-orch
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_ACKS=all
KAFKA_MAX_POLL_RECORDS=20
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_PARTITIONS_DEFAULT=12
KAFKA_REPLICATION_FACTOR=3                 # set to 1 for local

# ---------- Cloudflare ----------
# Account-owned API token with: Cloudflare Tunnel:Edit, DNS:Edit, Account Settings:Read
CLOUDFLARE_API_TOKEN=                      # required at runtime
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_DEFAULT_ACCOUNT_ID=             # default tenant; per-tenant overrides in DB
CLOUDFLARE_RATE_LIMIT_PER_5MIN=1200
CLOUDFLARE_REQUEST_TIMEOUT_SECONDS=30
CLOUDFLARE_TUNNEL_CONFIG_SRC=cloudflare    # remotely-managed (do NOT change)

# ---------- Kubernetes ----------
# Mode: incluster | kubeconfig
K8S_MODE=kubeconfig
K8S_KUBECONFIG_PATH=~/.kube/config
K8S_CONTEXT=                               # leave empty for current-context
K8S_DEFAULT_NAMESPACE=tunnels
K8S_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2024.10.0
K8S_CLOUDFLARED_REPLICAS=2
K8S_CLOUDFLARED_RESOURCES_CPU_REQUEST=100m
K8S_CLOUDFLARED_RESOURCES_CPU_LIMIT=500m
K8S_CLOUDFLARED_RESOURCES_MEM_REQUEST=128Mi
K8S_CLOUDFLARED_RESOURCES_MEM_LIMIT=256Mi

# ---------- Multi-cluster ----------
# Optional: JSON map of {cluster_name: kubeconfig_path}
K8S_MULTI_CLUSTER_CONFIG=

# ---------- Verification ----------
DNS_VERIFY_TIMEOUT_SECONDS=180
DNS_VERIFY_INTERVAL_SECONDS=5
DNS_VERIFY_NAMESERVERS=1.1.1.1,8.8.8.8
HTTP_VERIFY_TIMEOUT_SECONDS=120
HTTP_VERIFY_INTERVAL_SECONDS=3
HTTP_VERIFY_EXPECTED_STATUS=200,204,301,302

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=tunnel-orchestrator
OTEL_RESOURCE_ATTRIBUTES=service.namespace=platform,deployment.environment=local
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
PROMETHEUS_METRICS_PORT=9100

# ---------- Resilience ----------
SAGA_STEP_TIMEOUT_SECONDS=120
SAGA_GLOBAL_TIMEOUT_SECONDS=600
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=500
RETRY_MAX_DELAY_MS=15000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60
