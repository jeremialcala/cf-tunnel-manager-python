# syntax=docker/dockerfile:1.9
# =====================================================================
# Tunnel Orchestrator — base image
# =====================================================================
# Stage 1: builder — installs deps with `uv` into a virtualenv layer
# Stage 2: runtime — minimal distroless-style python:slim with venv
# =====================================================================

ARG PYTHON_VERSION=3.12

# ----------------------- builder ----------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN uv venv /opt/venv && uv sync --no-dev --frozen 2>/dev/null || uv sync --no-dev

# Source
COPY apps ./apps
COPY services ./services
COPY shared ./shared
COPY platform ./platform

# Pre-compile bytecode for faster cold-start
RUN /opt/venv/bin/python -m compileall -q apps services shared platform

# ----------------------- runtime ----------------------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH=/opt/venv/bin:$PATH \
    APP_HOME=/app

# Add curl for healthchecks; tini for proper signal handling
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl tini ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd  --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app
COPY migrations ./migrations
COPY platform/schemas ./platform/schemas

USER app

ENTRYPOINT ["/usr/bin/tini", "--"]

LABEL org.opencontainers.image.title="tunnel-orchestrator-base" \
      org.opencontainers.image.source="https://github.com/your-org/tunnel-orchestrator" \
      org.opencontainers.image.licenses="Apache-2.0"
