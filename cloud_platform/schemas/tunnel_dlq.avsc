{
  "type": "record",
  "name": "TunnelDlq",
  "namespace": "com.tunnel.events.v1",
  "fields": [
    { "name": "original_topic",      "type": "string" },
    { "name": "original_partition",  "type": "int" },
    { "name": "original_offset",     "type": "long" },
    { "name": "original_event_type", "type": "string" },
    { "name": "original_payload_b64","type": "string" },
    {
      "name": "original_headers",
      "type": { "type": "map", "values": "string" },
      "default": {}
    },
    { "name": "dlq_reason",   "type": "string" },
    { "name": "dlq_stack",    "type": ["null", "string"], "default": null },
    { "name": "first_seen_at","type": { "type": "long", "logicalType": "timestamp-micros" } },
    { "name": "attempts",     "type": "int", "default": 1 }
  ]
}
